# Backend API origin. Do not include a trailing /api here; Next proxy routes add
# /api/auth, /api/v1/admin, and /api/v1/student themselves.
API_BASE_URL=https://ielts-master.duckdns.org
AUTH_API_BASE_URL=https://ielts-master.duckdns.org
STUDENT_API_BASE_URL=https://ielts-master.duckdns.org
NEXT_PUBLIC_API_BASE_URL=https://ielts-master.duckdns.org

# Google sign-in client ID. Fill this with the OAuth web client ID when enabling
# Google auth.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_ID=
AUTH_GOOGLE_CLIENT_ID=
